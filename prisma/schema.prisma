// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Song {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  title    String
  artists  String[]
  genres   String[]
  coverUrl String
  pages    Page[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("songs")
}

type Page {
  id          Int
  type        String // "lyrics" | "lyrics2" | "chords"
  title       String
  content     String
  lyrics2Data Json?  // Objeto JSON para dados lyrics2 (sections + order com repetitions)
  isMain      Boolean
}

model Artist {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  genre     String
  songCount Int
  avatarUrl String
  verified  Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("artists")
}

model Repertoire {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  owner       String
  songIds     String[] @db.ObjectId
  description String
  coverUrl    String
  isPublic    Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("repertoires")
}

model LastSeen {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  itemId    String   @db.ObjectId
  type      String   // "song" | "artist" | "repertoire"
  timestamp DateTime @default(now())

  @@map("last_seen")
}

model User {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  email     String       @unique
  password  String
  name      String
  settings  UserSettings?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

type UserSettings {
  showRepertoiresInSongCard Boolean @default(true)
  sheetFontSize             Int     @default(16)
}

model Session {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  expiresAt DateTime

  createdAt DateTime @default(now())

  @@map("sessions")
}
